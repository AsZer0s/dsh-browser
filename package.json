{
  "name": "dsh-browser",
  "version": "0.4.0",
  "description": "AI-controlled sidebar browser for DeepSeek Harness with per-session isolation, live human takeover, and real-time pointer input.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:artifacts": "node scripts/build.mjs",
    "build:check": "tsc --noEmit",
    "build": "npm run build:artifacts && npm run build:check",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/*.e2e.mjs",
    "browser:install": "playwright install chromium",
    "prepack": "npm run build"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-include": "^1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
